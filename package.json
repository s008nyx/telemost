{
  "name": "telemost",
  "version": "1.0.0",
  "description": "Telemost — generated by sitedock",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder"
  },
  "build": {
    "appId": "com.sitedock.telemost",
    "productName": "Telemost",
    "directories": { "output": "dist" },
    "afterPack": "build/afterPack.js",
    "mac": { "target": "dmg" },
    "win": { "target": "nsis" },
    "linux": { "target": "AppImage" }
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  }
}
